PORT=8081
SECRET_KEY=change-me-in-production
DATABASE_NAME=mirestaurante
DATABASE_URI=mongodb://127.0.0.1:27017
# Producción: mismo cluster de Atlas que MiTiendita, base separada (DATABASE_NAME=mirestaurante)
# DATABASE_URI=mongodb+srv://madgrismad_db_user:<db_password>@cluster0.8z0wbpq.mongodb.net/
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8081
NODE_ENV=development

# SMTP (invites / password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Mercado Pago (dejar vacío = modo mock de billing)
MP_ACCESS_TOKEN=
MP_CURRENCY=MXN
MP_PLAN_BASIC_PRICE=799
MP_PLAN_PRO_PRICE=1499

# Terminal de cobro Mercado Pago Point (cada negocio conecta SU cuenta por OAuth)
# Crea una aplicación en https://www.mercadopago.com.mx/developers/panel/app y configura:
#   - Redirect URL:   {API_PUBLIC_URL}/point/oauth/callback   (igual a MP_OAUTH_REDIRECT)
#   - Webhooks -> evento "Order (Mercado Pago)": {API_PUBLIC_URL}/point/webhook
# Clave secreta del webhook (Tus integraciones > Webhooks > "Clave secreta"). Obligatoria en producción.
MP_WEBHOOK_SECRET=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_OAUTH_REDIRECT=http://localhost:8081/point/oauth/callback
# Firma el parámetro state del OAuth. Genera uno: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_STATE_SECRET=
# Cifra los tokens de cada negocio (AES-256-GCM): 32 bytes en hex (64 caracteres). Mismo comando de arriba.
TOKEN_ENC_KEY=

# Platform admin seed
PLATFORM_ADMIN_EMAIL=platform@mirestaurante.com
PLATFORM_ADMIN_USERNAME=platform
PLATFORM_ADMIN_PASSWORD=Platform123!

# Uber Eats (Marketplace API): una sola aplicación atiende a todos los negocios.
# sandbox = aplicación de pruebas; production = aplicación aprobada por Uber.
UBER_EATS_ENV=sandbox
UBER_EATS_CLIENT_ID=
UBER_EATS_CLIENT_SECRET=
# Opcional: URLs distintas a las de Uber (la documentación de pruebas menciona dos dominios de login)
# UBER_EATS_AUTH_URL=
# UBER_EATS_API_URL=
